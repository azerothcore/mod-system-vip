[worldserver]

########################################
# SYSTEM VIP CONFIGURATION
########################################
#
#    SystemVip.Announce
#        Description: Enables a module announcement message on login.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Announce = 0

########################################
#
#    SystemVip.TimeVip
#        Description: Time in days added for each subscription.
#        Default:     7
#

SystemVip.TimeVip = 7

########################################
#
#    SystemVip.Token
#        Description: Item used as token to buy a VIP subscription.
#        Default:    29736
#

SystemVip.Token = 29736

########################################
#
#    SystemVip.TokenAmount
#        Description: Amount of tokens required.
#        Default:     10
#

SystemVip.TokenAmount = 10

########################################
#
#    SystemVip.TokenIcon
#        Description: Token icon.
#        Default:     "|TInterface/ICONS/inv_misc_rune_05:15:15:-15:0|t"
#

SystemVip.TokenIcon = "|TInterface/ICONS/inv_misc_rune_05:15:15:-15:0|t"

########################################
# SYSTEM VIP ADVANTAGES CONFIGURATION
########################################
#
#    SystemVip.LoginAnnounce
#        Description: Enables a special welcome announcement for VIP players.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.LoginAnnounce = 0

########################################
#
#    SystemVip.LoginAnnounceMessage
#        Description: Message shown in the welcome announcement. The %s symbol is replaced by the player name.
#        Default:     "VIP player %s has logged in."
#

SystemVip.LoginAnnounceMessage = "VIP player %s has logged in."

########################################
#
#    SystemVip.EnableRateCustom
#        Description: Enables custom rates for VIP players.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.EnableRateCustom = 0

########################################
#
#    SystemVip.RateXP
#        Description: Experience rate multiplier for VIP players. Set to 1 for the normal rate.
#        Default:     1
#

SystemVip.RateXP = 1

########################################
#
#    SystemVip.ProfessionRate
#        Description: Profession rate multiplier for VIP players. Set to 1 for the normal rate.
#        Default:     1
#

SystemVip.ProfessionRate = 1

########################################
#
#    SystemVip.GoldRate
#        Description: Gold rate multiplier for VIP players. Set to 1 for the normal rate.
#        Default:     1
#

SystemVip.GoldRate = 1

########################################
#
#    SystemVip.HonorRate
#        Description: Honor rate multiplier for VIP players. Set to 1 for the normal rate.
#        Default:     1
#

SystemVip.HonorRate = 1

########################################
#
#    SystemVip.GhostMount
#        Description: Enables a speed boost when a VIP player dies and becomes a ghost.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.GhostMount = 0

########################################
# SYSTEM VIP PET CONFIGURATION
########################################
#
#    SystemVip.Pet
#        Description: Enables the pet for VIP players.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Pet = 0

########################################
#
#    SystemVip.VipZone
#        Description: Enables a teleport to a special zone for VIP players.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.VipZone = 0

########################################
#
#    SystemVip.VipZoneMapId
#    SystemVip.VipZoneCoorX
#    SystemVip.VipZoneCoorY
#    SystemVip.VipZoneCoorZ
#    SystemVip.VipZoneOrien
#        Description: Map ID, coordinates and orientation of the VIP zone.
#        Default:     571, 5804.15, 624.771, 647.767, 1.64 (Dalaran)
#

SystemVip.VipZoneMapId = 571
SystemVip.VipZoneCoorX = 5804.15
SystemVip.VipZoneCoorY = 624.771
SystemVip.VipZoneCoorZ = 647.767
SystemVip.VipZoneOrien = 1.64

########################################
#
#    SystemVip.ArmorRep
#        Description: Enables an option to repair armor for free for VIP players.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.ArmorRep = 0

########################################
#
#    SystemVip.Bank
#        Description: Enables an option to open the bank.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Bank = 0

########################################
#
#    SystemVip.Mail
#        Description: Enables an option to open the mailbox.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Mail = 0

########################################
#
#    SystemVip.Buffs
#        Description: Enables an option to receive buffs.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Buffs = 0

########################################
#
#    SystemVip.BuffIds
#        Description: IDs of the buffs to cast. Must be comma-separated without spaces.
#        Default:     "12312,123123,123123"
#

SystemVip.BuffIds = "25898,48469,42995,48169,48073,48161,53307,23735,23736,23737,23738,23766,23767,23768,23769"

########################################
#
#    SystemVip.Refresh
#        Description: Enables an option to restore health and mana.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Refresh = 0

########################################
#
#    SystemVip.Sickness
#        Description: Enables an option to remove resurrection sickness.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Sickness = 0

########################################
#
#    SystemVip.Deserter
#        Description: Enables an option to remove the deserter debuff.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.Deserter = 0

########################################
#
#    SystemVip.ResetInstance
#        Description: Enables an option to reset dungeon and raid instance lockouts.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.ResetInstance = 0

########################################
#
#    SystemVip.SaveTeleport
#        Description: Enables an option to save locations to teleport to.
#        Default:     0 - Disabled
#                     1 - Enabled
#

SystemVip.SaveTeleport = 0

########################################
#
#    SystemVip.SaveTeleportAmount
#        Description: Maximum number of locations that can be saved.
#        Default:     5
#

SystemVip.SaveTeleportAmount = 5

